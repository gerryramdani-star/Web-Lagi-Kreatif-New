<!-- Custom CSS (Animasi & Setup Dasar) -->
<style>
    body {
        background-color: #FAFAFA;
        color: #475569;
        overflow-x: hidden;
    }
    h1, h2, h3, h4, h5, h6 {
        color: #1E293B;
    }
    /* Hide scrollbar for clean look in some overflow containers */
    .hide-scrollbar::-webkit-scrollbar {
        display: none;
    }
    .hide-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }

    /* Animasi Expand Ring (Tombol) */
    @keyframes ringExpand {
        0% { transform: scale(1); opacity: 0.8; }
        100% { transform: scale(1.15); opacity: 0; }
    }
    .btn-expand-ring {
        position: relative;
    }
    .btn-expand-ring::after {
        content: '';
        position: absolute;
        inset: 0;
        border-radius: inherit; 
        pointer-events: none;
        opacity: 0;
    }
    .btn-expand-ring.ring-accent::after {
        border: 2px solid #2563EB; /* Biru Accent */
    }
    .btn-expand-ring.ring-white::after {
        border: 2px solid rgba(255, 255, 255, 0.4); /* Putih */
    }
    .btn-expand-ring.ring-whatsapp::after {
        border: 2px solid #25D366; /* Hijau WhatsApp */
    }
    .btn-expand-ring:hover::after {
        animation: ringExpand 0.6s ease-out forwards;
    }

    /* Animasi Glare Effect (Kilatan Cahaya Tombol Navbar) */
    @keyframes glareAnim {
        0% { left: -50px; }
        50% { left: 120%; } /* Melintas ke kanan */
        100% { left: 120%; } /* Delay jeda sejenak sebelum mengulang */
    }
    .btn-glare::before {
        content: '';
        position: absolute;
        top: 0;
        bottom: 0;
        left: -50px; 
        width: 50px;
        transform: skewX(-20deg); 
        background: linear-gradient(to right, rgba(255,255,255,0), rgba(255,255,255,0.25), rgba(255,255,255,0));
        pointer-events: none; 
        z-index: 10;
    }
    .btn-glare:hover::before {
        animation: glareAnim 1.8s ease-in-out infinite;
    }
</style>

