<!-- MODUL 15: CONTACT MODAL & SYSTEM SCRIPTS -->

<!-- Contact Modal (Tersembunyi secara default) -->
<div id="contact-modal" class="fixed inset-0 z-[100] hidden flex items-center justify-center px-4">
    <div class="absolute inset-0 bg-primary-dark/80 backdrop-blur-sm" onclick="closeModal()"></div>
    <div class="bg-white w-full max-w-lg rounded-2xl p-8 relative z-10 shadow-2xl transform scale-95 opacity-0 transition-all duration-300" id="modal-content">
        <button onclick="closeModal()" class="absolute top-6 right-6 text-neutral-body hover:text-neutral-dark text-xl">
            <i class="fa-solid fa-xmark"></i>
        </button>
        <h3 class="text-2xl font-bold text-neutral-dark mb-2">Jadwalkan Diskusi</h3>
        <p class="text-neutral-body text-sm mb-6">Isi form di bawah ini untuk terhubung langsung dengan tim kami via WhatsApp.</p>
        
        <form id="wa-form" onsubmit="submitForm(event)" class="space-y-4">
            <div>
                <label class="block text-sm font-medium text-neutral-dark mb-1">Nama Lengkap</label>
                <input type="text" id="form-name" required class="w-full px-4 py-2.5 border border-neutral-border rounded-lg focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors" placeholder="John Doe">
            </div>
            <div>
                <label class="block text-sm font-medium text-neutral-dark mb-1">Perusahaan / Instansi</label>
                <input type="text" id="form-company" required class="w-full px-4 py-2.5 border border-neutral-border rounded-lg focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors" placeholder="PT Nama Perusahaan">
            </div>
            <div>
                <label class="block text-sm font-medium text-neutral-dark mb-1">Minat Layanan</label>
                <select id="form-service" class="w-full px-4 py-2.5 border border-neutral-border rounded-lg focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors bg-white">
                    <option value="Brand Strategy">Brand Strategy</option>
                    <option value="Communication & Campaign">Communication & Campaign</option>
                    <option value="Experience & Impact">Experience & Impact</option>
                    <option value="Lainnya">Lainnya / Belum Yakin</option>
                </select>
            </div>
            <div>
                <label class="block text-sm font-medium text-neutral-dark mb-1">Pesan Singkat</label>
                <textarea id="form-message" rows="3" required class="w-full px-4 py-2.5 border border-neutral-border rounded-lg focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors" placeholder="Ceritakan singkat tantangan bisnis Anda..."></textarea>
            </div>
            <button type="submit" class="w-full bg-accent hover:bg-accent-hover text-white py-3 rounded-lg font-bold transition-all shadow-md mt-4 flex items-center justify-center gap-2 hover:scale-[1.02] active:scale-95">
                <i class="fa-brands fa-whatsapp text-lg"></i> Kirim ke WhatsApp
            </button>
        </form>
    </div>
</div>

<!-- Scripts -->
<script>
    // 1. Mobile Menu Toggle
    const mobileBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    
    if(mobileBtn && mobileMenu) {
        mobileBtn.addEventListener('click', () => {
            mobileMenu.classList.toggle('hidden');
            const icon = mobileBtn.querySelector('i');
            if(mobileMenu.classList.contains('hidden')){
                icon.classList.remove('fa-xmark');
                icon.classList.add('fa-bars');
            } else {
                icon.classList.remove('fa-bars');
                icon.classList.add('fa-xmark');
            }
        });

        // Close mobile menu on link click
        mobileMenu.querySelectorAll('a').forEach(link => {
            link.addEventListener('click', () => {
                mobileMenu.classList.add('hidden');
                mobileBtn.querySelector('i').classList.replace('fa-xmark', 'fa-bars');
            });
        });
    }

    // 2. Sticky Header Style on Scroll
    window.addEventListener('scroll', () => {
        const header = document.getElementById('navbar');
        if(header) {
            if (window.scrollY > 20) {
                header.classList.add('shadow-sm');
            } else {
                header.classList.remove('shadow-sm');
            }
        }
    });

    // 3. Modal Logic
    const modal = document.getElementById('contact-modal');
    const modalContent = document.getElementById('modal-content');

    window.openModal = function() {
        if(modal && modalContent) {
            modal.classList.remove('hidden');
            // Timeout kecil agar display:block teraplikasi sebelum transisi opacity
            setTimeout(() => {
                modalContent.classList.remove('scale-95', 'opacity-0');
                modalContent.classList.add('scale-100', 'opacity-100');
            }, 10);
        }
    }

    window.closeModal = function() {
        if(modal && modalContent) {
            modalContent.classList.remove('scale-100', 'opacity-100');
            modalContent.classList.add('scale-95', 'opacity-0');
            setTimeout(() => {
                modal.classList.add('hidden');
            }, 300); // Sesuaikan dengan durasi transisi
        }
    }

    // 4. WhatsApp Form Submit Logic
    window.submitForm = function(e) {
        e.preventDefault();
        
        const name = document.getElementById('form-name').value;
        const company = document.getElementById('form-company').value;
        const service = document.getElementById('form-service').value;
        const message = document.getElementById('form-message').value;
        
        // Format Pesan WhatsApp
        const text = `Halo tim Lagi Kreatif, saya tertarik untuk berdiskusi lebih lanjut.\n\n*Nama:* ${name}\n*Perusahaan:* ${company}\n*Layanan Diminati:* ${service}\n*Pesan:* ${message}\n\nTerima kasih.`;
        
        // Encode URL untuk text
        const encodedText = encodeURIComponent(text);
        const waNumber = "6281234567890"; // Nomor dari PRD
        
        // Buka WA di tab baru
        window.open(`https://wa.me/${waNumber}?text=${encodedText}`, '_blank');
        
        // Reset form & tutup modal
        document.getElementById('wa-form').reset();
        closeModal();
    }

    // 5. Intersection Observer untuk Animasi Garis & Tahapan (Section Cara Kerja)
    document.addEventListener('DOMContentLoaded', () => {
        const processSection = document.getElementById('process');
        const processLine = document.getElementById('process-line');
        const processSteps = document.querySelectorAll('.process-step');

        if(processSection && processLine && processSteps.length > 0) {
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    // Jika section process terlihat setidaknya 40% di layar
                    if (entry.isIntersecting) {
                        // Animasi pelebaran garis (dari 0 ke 100%)
                        processLine.classList.remove('scale-x-0');
                        processLine.classList.add('scale-x-100');

                        // Animasi fade in & slide up untuk tiap step
                        processSteps.forEach(step => {
                            step.classList.remove('opacity-0', 'translate-y-8');
                            step.classList.add('opacity-100', 'translate-y-0');
                        });

                        // Hentikan observer agar hanya berjalan 1 kali
                        observer.unobserve(entry.target);
                    }
                });
            }, { threshold: 0.4 }); 

            observer.observe(processSection);
        }
    });
</script>
